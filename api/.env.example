# ==============================================
# JxMall 全局统一环境配置 (.env)
# ==============================================
# 此文件为全站唯一配置源 (Single Source of Truth)
# PHP端(phpdotenv), 以及 Bash部署脚本(deploy.sh) 均直接读取此文件。

# -----------------------------
# 应用基础 (PHP)
# -----------------------------
APP_NAME=JXMALL
APP_URL=http://localhost
APP_TIMEZONE=Asia/Shanghai

YII_DEBUG=false
YII_ENV=prod

# 安全密钥 (通过 $_ENV 注入到 PHP config/web.php 中)
COOKIE_VALIDATION_KEY=your_secret_key_here

# -----------------------------
# 数据库 (MySQL)
# -----------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# 兼容 deploy.sh 占位符和 Yii
DB_NAME=your_db_name
DB_USER=root
DB_PASS=root
DB_PREFIX=jxmall_

# -----------------------------
# 缓存 & 队列 (Redis)
# -----------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASS=
REDIS_QUEUE_CHANNEL=jxmall

# Go 调度器使用的 Redis Key前缀
REDIS_KEY_TASK=jxmall_scheduler
REDIS_KEY_EVENT=jxmall_scheduler_event
REDIS_KEY_CRON=jxmall_cron_config
REDIS_KEY_ADMIN_LOG=admin_action_logs
REDIS_KEY_USER_LOG=user_action_logs
REDIS_KEY_YII_LOG=yii_error_logs

# -----------------------------
# Go 调度进程 (Scheduler)
# -----------------------------
GO_PORT=:8081
GO_WORKER_NUM=50

# PHP FPM 通信设置 (Go 服务调用)
PHP_FPM_NETWORK=unix
PHP_FPM_ADDR=/tmp/phpwebstudy-php-cgi-82.sock

# -----------------------------
# Supervisor 守护进程部署设置
# -----------------------------
GO_BINARY_NAME=scheduler
GO_PROGRAM_NAME=jxmall_scheduler
RUN_USER=www
SUPERVISOR_CONF_DIR=AUTO
SUPERVISOR_EXT=AUTO

# -----------------------------
# 邮件 (SMTP)
# -----------------------------
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=user@mailgun.org
MAIL_PASSWORD=secret
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------
# 安全与其他配置
# -----------------------------
# 密码 Hash 计算代价 (dev可以设为4提速, 生产建议13)
SECURITY_HASH_COST=13
USE_MONGODB=false

# 硬件 Webhook 安全令牌（硬件设备回调鉴权）
HW_WEBHOOK_TOKEN=your_hw_webhook_token_here
# 允许访问 Webhook 的 IP 白名单，逗号分隔
HW_WEBHOOK_ALLOWED_IPS=127.0.0.1,::1

# -----------------------------
# EMQX MQTT Broker（硬件下行推送）
# -----------------------------
# REST API 基地址（EMQX v5，Dashboard 默认 18083 端口）
EMQX_API_URL=http://127.0.0.1:18083/api/v5
# Dashboard → Applications → API Keys 生成
EMQX_API_KEY=your_emqx_api_key
EMQX_API_SECRET=your_emqx_api_secret

# -----------------------------
# 微信小程序代码上传（miniprogram-ci CLI，后台「上传代码」用）
# -----------------------------
# node 可执行文件路径（默认 node；PHP-FPM 的 PATH 常无 node 时填全路径，如 /usr/local/bin/node）
MINIPROGRAM_CI_NODE=node
# miniprogram-ci CLI 路径（留空则默认 api/uploadserver/node_modules/.bin/miniprogram-ci）
MINIPROGRAM_CI_BIN=
# 部署时安装 uploadserver 依赖用的 npm 源（留空=默认用国内镜像 registry.npmmirror.com，避免连官方源转圈）
# 如需指定其它源在此填写，例：https://registry.npmmirror.com
MINIPROGRAM_CI_NPM_REGISTRY=
# deploy.sh 自动安装 Node 的版本与镜像（仅 Linux、当前无 Node≥16 时触发；一般留默认即可）
NODE_SETUP_VERSION=v20.18.0
NODE_MIRROR=https://npmmirror.com/mirrors/node
