	"easycom": {
		"autoscan": true,
		"custom": {
			"^t-icon$": "@/components/t-icon/t-icon.vue",
			// ⛔ 下面这一组「精确规则」必须排在通配规则**前面** —— easycom 按声明顺序取第一个命中的。
			//
			// 这些组件只被单个分包使用,已从主包 components/ 下沉到各自分包,给主包腾体积
			// (无感积分插件要求声明在 app.json 顶层,而顶层声明的插件体积计入主包)。
			//
			// ⚠ 下沉之后**光加显式 import 不够**:easycom 的通配规则优先级高于组件的
			//   `components` 注册 —— 模板里只要出现 <tui-tabs>,它就照 `tui-(.*)` 生成
			//   `@/components/thorui/tui-tabs/tui-tabs.vue` 的 import,根本不看你注册没注册,
			//   于是编译期直接「文件查找失败」。所以路径必须在这儿改。
			//   (cat-theme 走 autoscan 而非通配规则,失配后会回退到显式注册,所以它没报错 ——
			//    两种机制表现不同,别拿它的结果推断这几个。)
			"^tui-changemobile$": "@/others/components/tui-changemobile/tui-changemobile.vue",
			"^tui-loginpwd$": "@/others/components/tui-loginpwd/tui-loginpwd.vue",
			"^tui-paypwd$": "@/others/components/tui-paypwd/tui-paypwd.vue",
			"^tui-swipe-action$": "@/others/components/tui-swipe-action/tui-swipe-action.vue",
			"^tui-tabs$": "@/others/components/tui-tabs/tui-tabs.vue",
			"^tui-navigation-bar$": "@/plugins1/components/tui-navigation-bar/tui-navigation-bar.vue",

			"tui-(.*)": "@/components/thorui/tui-$1/tui-$1.vue",
			"^u-(.*)": "@/uni_modules/uview-ui/components/u-$1/u-$1.vue",
			"^d-(.*)": "@/components/jxmall/d-$1/d-$1.vue"
		}
	},
	"preloadRule": {
		"pages/index/index": {
			"network": "all",
			"packages": [
				"plugins"
			]
		}
	},
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "uni-app",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F3F3F3"
	}
}
